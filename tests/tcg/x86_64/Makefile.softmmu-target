#
# x86_64 system tests
#

X64_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/x86_64/system
X64_SYSTEM_TESTS=$(patsubst $(X64_SYSTEM_SRC)/%.c, %, $(wildcard $(X64_SYSTEM_SRC)/*.c))

VPATH+=$(X64_SYSTEM_SRC)

# These objects provide the basic boot code and helper functions for all tests
CRT_OBJS=boot.o

CRT_PATH=$(X64_SYSTEM_SRC)
LINK_SCRIPT=$(X64_SYSTEM_SRC)/kernel.ld
LDFLAGS=-Wl,-T$(LINK_SCRIPT) -Wl,-melf_x86_64
CFLAGS+=-nostdlib -ggdb -O0 $(MINILIB_INC)
LDFLAGS+=-static -nostdlib $(CRT_OBJS) $(MINILIB_OBJS) -lgcc

TESTS+=$(MULTIARCH_TESTS) $(X64_SYSTEM_TESTS)
EXTRA_RUNS+=$(MULTIARCH_RUNS)

# building head blobs
.PRECIOUS: $(CRT_OBJS)

%.o: $(CRT_PATH)/%.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -Wa,--noexecstack -c $< -o $@

# Build and link the tests
%: %.c $(LINK_SCRIPT) $(CRT_OBJS) $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ $(LDFLAGS)

memory: CFLAGS+=-DCHECK_UNALIGNED=1

# Running
QEMU_OPTS+=-device isa-debugcon,chardev=output -device isa-debug-exit,iobase=0xf4,iosize=0x4 -kernel

# tlb-next-page uses memory up to 194 MiB.
run-tlb-next-page: QEMU_OPTS := -m 256M $(QEMU_OPTS)

# The RCG tests' cases come from the tables RCG's gadgets are made from,
# with the data addresses rcg-test.h defines. Making rcg-insns.h also checks
# every gadget's body.
RCG_GEN=$(SRC_PATH)/target/i386/tcg/rcg-gen.py
RCG_GEN_DEPS=$(RCG_GEN) $(SRC_PATH)/tcg/aarch64-tcti/tcti_memory.py \
	$(X64_SYSTEM_SRC)/rcg-test.h
CLEANFILES += rcg-insns.h rcg-jcc.h rcg-jcc.ref rcg-faults.h

rcg-insns.h: $(RCG_GEN_DEPS)
	$(call quiet-command, $(PYTHON) $< --check --insn-tests $@, GEN, $@)
rcg-jcc.h: $(RCG_GEN_DEPS)
	$(call quiet-command, $(PYTHON) $< --jcc-tests $@, GEN, $@)
rcg-faults.h: $(RCG_GEN_DEPS)
	$(call quiet-command, $(PYTHON) $< --fault-tests $@, GEN, $@)

rcg-insns: rcg-insns.h rcg-test.h
rcg-jcc: rcg-jcc.h rcg-insns.c rcg-test.h
rcg-faults: rcg-faults.h rcg-test.h
rcg-insns rcg-jcc rcg-faults: CFLAGS += -I.

# RCG_MEM, as rcg-test.h explains.
RCG_MEM=$(shell sed -n 's/^\#define RCG_MEM \(0x[0-9a-f]*\)$$/\1/p' \
	$(X64_SYSTEM_SRC)/rcg-test.h)
rcg-insns rcg-jcc rcg-faults: LDFLAGS += -Wl,--defsym=rcg_mem=$(RCG_MEM)

# rcg-insns prints a hash of each case's results, which must match TCG's,
# held in rcg-insns.ref. It runs for about two minutes under TCTI on an M2
# Max, so it gets longer than the default timeout.
run-rcg-insns: TIMEOUT=600
run-rcg-insns: rcg-insns
	$(call run-test, $<, \
	  $(QEMU) -monitor none -display none \
		  -chardev file$(COMMA)path=$<.out$(COMMA)id=output \
		  $(QEMU_OPTS) $<)
	$(call diff-out, $<, $(X64_SYSTEM_SRC)/rcg-insns.ref)

# rcg-jcc runs rcg-insns' Jcc cases without goto_tb, so that they run the
# plain gadgets; see rcg-jcc.c. Their hashes are rcg-insns.ref's lines for
# the cases jcc_cases() in rcg-gen.py picks.
run-rcg-jcc: TIMEOUT=600
run-rcg-jcc: rcg-jcc
	$(call run-test, $<, \
	  $(QEMU) -d nochain -monitor none -display none \
		  -chardev file$(COMMA)path=$<.out$(COMMA)id=output \
		  $(QEMU_OPTS) $<)
	@grep -E '(^|; )j[a-z]+ 1f; mov ecx, 1; 1:: ' \
		$(X64_SYSTEM_SRC)/rcg-insns.ref > $<.ref
	$(call diff-out, $<, $<.ref)

ifeq ($(CONFIG_PLUGIN),y)
run-plugin-patch-target-with-libpatch.so:		\
	PLUGIN_ARGS=$(COMMA)target=ffc0$(COMMA)patch=9090$(COMMA)use_hwaddr=true
run-plugin-patch-target-with-libpatch.so:		\
	CHECK_PLUGIN_OUTPUT_COMMAND=$(X64_SYSTEM_SRC)/validate-patch.py $@.out
run-plugin-patch-target-with-libpatch.so: patch-target libpatch.so
EXTRA_RUNS_WITH_PLUGIN+=run-plugin-patch-target-with-libpatch.so
endif
